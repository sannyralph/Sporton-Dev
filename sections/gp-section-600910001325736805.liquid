      <style id="custom-css-gWKklEzpqC">
        @import url('https://fonts.googleapis.com/css2?family=Anta&display=swap');

.gp-custom-related {
  margin: 40px 0;
  padding: 0 20px;
}

.gp-custom-related h3 {
  font-family: 'Anta', sans-serif;
  font-size: 24px;
  font-weight: normal;
  text-align: center;
  margin: 0 0 30px 0;
  color: #333;
}

.gps .gp-custom-related ul {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  gap: 20px;
  list-style: none;
  padding: 0;
  margin: 0;
  justify-content: center;
}

.gps .gp-custom-related ul li {
  flex: 0 0 calc(33.333% - 14px);
  max-width: 400px;
  display: flex;
  flex-direction: column;
  background: transparent;
  border-radius: 0;
  overflow: hidden;
  box-shadow: none;
  transition: none;
}

.gps .gp-custom-related ul li:hover {
  transform: none;
  box-shadow: none;
}

.gp-custom-related ul li img {
  width: 100%;
  height: 400px;
  object-fit: cover;
  border-radius: 12px;
  display: block;
}

.gp-custom-related ul li a {
  text-decoration: none;
  color: inherit;
  display: block;
}

.gp-custom-related ul li .product-info {
  padding: 20px 10px;
  text-align: center;
  background: transparent;
}

.gp-custom-related ul li .product-title {
  font-family: 'Anta', sans-serif;
  font-size: 18px;
  font-weight: normal;
  color: #333;
  margin: 0 0 8px 0;
  line-height: 1.3;
}

.gp-custom-related ul li .product-price {
  font-family: 'Anta', sans-serif;
  font-size: 16px;
  color: #333;
  font-weight: normal;
  margin: 0 0 20px 0;
}

.gp-custom-related ul li .add-to-cart-btn {
  background: #333;
  color: white;
  border: none;
  padding: 15px 30px;
  border-radius: 8px;
  font-family: 'Anta', sans-serif;
  font-size: 14px;
  cursor: pointer;
  transition: background 0.2s ease;
  text-transform: none;
  width: 100%;
  max-width: 200px;
  margin: 0 auto;
  display: block;
}

.gp-custom-related ul li .add-to-cart-btn:hover {
  background: #000;
}

/* Responsive adjustments */
@media (max-width: 1024px) {
  .gps .gp-custom-related ul {
    gap: 15px;
  }
  
  .gps .gp-custom-related ul li {
    flex: 0 0 calc(33.333% - 10px);
  }
  
  .gp-custom-related ul li img {
    height: 350px;
  }
}

@media (max-width: 768px) {
  .gps .gp-custom-related ul {
    gap: 10px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    justify-content: flex-start;
  }
  
  .gps .gp-custom-related ul li {
    flex: 0 0 calc(50% - 5px);
    min-width: 250px;
  }
  
  .gp-custom-related ul li img {
    height: 300px;
  }
}

@media (max-width: 480px) {
  .gp-custom-related {
    padding: 0 15px;
  }
  
  .gps .gp-custom-related ul li {
    flex: 0 0 calc(100% - 10px);
    min-width: auto;
  }
  
  .gp-custom-related ul li img {
    height: 350px;
  }
}

