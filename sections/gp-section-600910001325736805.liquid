      <script id="custom-js-gWKklEzpqC">
        try {
          function addToCart(variantId) {
  fetch('/cart/add.js', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({
      items: [{
        id: variantId,
        quantity: 1
      }]
    })
  })
  .then(response => response.json())
  .then(data => {
    // Success feedback
    alert('Product added to cart!');
    // Or update cart count if you have one
    // updateCartCount();
  })
  .catch((error) => {
    console.error('Error:', error);
    alert('Error adding product to cart');
  });
}

