

<div class="section-background color-{{ section.settings.color_scheme }} sporton-footer__background"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} sporton-footer"
>
  {% liquid
    assign total_blocks = section.blocks.size

    # Grid layout calculations
    assign grid_columns = total_blocks | at_most: 4

    # Calculate last row counts using modulo arithmetic
    # last_row_count = (total_blocks - 1) % N + 1
    assign last_row_count = total_blocks | minus: 1 | modulo: 4 | plus: 1
    assign tablet_last_row_count = total_blocks | minus: 1 | modulo: 2 | plus: 1

    # Check if there are orphaned elements (single item in last row)
    assign has_isolated_grid_item_desktop = false
    assign has_isolated_grid_item_tablet = false

    if total_blocks > 4 and last_row_count == 1
      assign has_isolated_grid_item_desktop = true
    endif

    if total_blocks == 5
      assign has_isolated_grid_item_tablet = true
    endif
  %}
  <div
    class="
      footer-content
      spacing-style
      {% if has_isolated_grid_item_desktop %}footer-content--isolated-grid-item-desktop{% endif %}
      {% if has_isolated_grid_item_tablet %}footer-content--isolated-grid-item-tablet{% endif %}
    "
    style="
      {%  render 'spacing-style', settings: section.settings %}
      --footer-gap: {{ section.settings.gap }}px;
      --grid-columns: {{ grid_columns }};
      --last-row-count: {{ last_row_count }};
      --tablet-last-row-count: {{ tablet_last_row_count }};
    "
  >
    {% content_for 'blocks' %}
  </div>
</div>
{% stylesheet %}
  .sporton-footer__background {
    background: #ffffff !important;
  }

  .sporton-footer {
    background: #ffffff !important;
    color: #111111 !important;
    border-top: 1px solid #e5e5e5;
  }

  .sporton-footer .footer-content {
    width: min(100%, 1440px);
    margin-inline: auto;
    padding-block: 56px 42px;
    display: grid;
    grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
    gap: 48px 56px;
    contain: content;
    content-visibility: auto;
  }

  /* Remove dark block backgrounds inherited from the old color scheme */
  .sporton-footer .footer-content > *,
  .sporton-footer .footer-content > * > * {
    background: transparent !important;
    color: #111111 !important;
    box-shadow: none !important;
  }

  /* Headings */
  .sporton-footer :is(h1, h2, h3, h4, h5, h6, legend) {
    margin: 0 0 22px !important;
    color: #111111 !important;
    font-size: 11px !important;
    font-weight: 500 !important;
    line-height: 1.4 !important;
    letter-spacing: 0.18em !important;
    text-transform: uppercase !important;
  }

  /* Body copy */
  .sporton-footer :is(p, li, a, label) {
    color: #111111 !important;
    font-size: 14px !important;
    font-weight: 400 !important;
    line-height: 1.65 !important;
    letter-spacing: 0 !important;
  }

  .sporton-footer p {
    margin: 0 0 14px !important;
  }

  /* Menu links */
  .sporton-footer ul,
  .sporton-footer ol {
    display: flex;
    flex-direction: column;
    gap: 9px;
    margin: 0 !important;
    padding: 0 !important;
    list-style: none !important;
  }

  .sporton-footer a {
    text-decoration: none !important;
    transition: opacity 0.2s ease;
  }

  .sporton-footer a:hover {
    opacity: 0.55;
  }

  /* Logo blocks */
  .sporton-footer img {
    max-width: 150px;
    height: auto;
  }

  /* Social icons */
  .sporton-footer svg {
    color: #111111 !important;
  }

  .sporton-footer :is(.social-links, .social-links__list) {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  /* Newsletter form */
  .sporton-footer :is(input[type='email'], input[type='text']) {
    width: 100%;
    min-height: 44px;
    padding: 10px 0 !important;
    border: 0 !important;
    border-bottom: 1px solid #111111 !important;
    border-radius: 0 !important;
    background: transparent !important;
    color: #111111 !important;
    font-size: 14px !important;
  }

  .sporton-footer :is(input[type='email'], input[type='text'])::placeholder {
    color: #777777 !important;
    opacity: 1;
  }

  .sporton-footer button {
    min-height: 44px;
    margin-top: 14px;
    padding: 12px 26px !important;
    border: 1px solid #111111 !important;
    border-radius: 999px !important;
    background: #111111 !important;
    color: #ffffff !important;
    font-size: 11px !important;
    font-weight: 500 !important;
    letter-spacing: 0.18em !important;
    text-transform: uppercase !important;
  }

  .sporton-footer button:hover {
    background: #ffffff !important;
    color: #111111 !important;
  }

  /* Payment icons */
  .sporton-footer :is(.payment-icons, .payment-icons__list) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  /* Tablet */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .sporton-footer .footer-content {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 38px 32px;
    }
  }

  /* Mobile */
  @media screen and (max-width: 749px) {
    .sporton-footer .footer-content {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0;
      padding-block: 20px 24px;
    }

    .sporton-footer .footer-content > * {
      width: 100%;
      padding-block: 22px;
      border-bottom: 1px solid #e5e5e5;
    }

    .sporton-footer .footer-content > *:last-child {
      border-bottom: 0;
    }

    .sporton-footer :is(h1, h2, h3, h4, h5, h6, legend) {
      margin-bottom: 14px !important;
      font-size: 10px !important;
    }

    .sporton-footer :is(p, li, a, label) {
      font-size: 13px !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.footer",
  "class": "section-wrapper",
  "tag": "footer",
  "blocks": [
    {
      "type": "_divider"
    },
    {
      "type": "@app"
    },
    {
      "type": "button"
    },
    {
      "type": "follow-on-shop"
    },
    {
      "type": "group"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "menu"
    },
    {
      "type": "payment-icons"
    },
    {
      "type": "text"
    },
    {
      "type": "logo"
    },
    {
      "type": "jumbo-text"
    },
    {
      "type": "social-links"
    },
    {
      "type": "email-signup"
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "t:names.footer",
      "category": "t:categories.footer",
      "settings": {
        "gap": 20,
        "color_scheme": "scheme-1",
        "padding-block-start": 36,
        "padding-block-end": 36
      },
      "blocks": {
        "newsletter-group": {
          "type": "group",
          "settings": {
            "content_direction": "column",
            "vertical_on_mobile": true,
            "horizontal_alignment": "flex-start",
            "vertical_alignment": "center",
            "gap": 6,
            "width": "fill",
            "inherit_color_scheme": true
          },
          "blocks": {
            "newsletter-heading": {
              "type": "text",
              "settings": {
                "text": "t:html_defaults.join_our_email_list",
                "width": "100%",
                "alignment": "left",
                "type_preset": "h3"
              }
            },
            "newsletter-text": {
              "type": "text",
              "settings": {
                "text": "t:html_defaults.get_exclusive_deals_and_early_access_to_new_products",
                "width": "100%",
                "alignment": "left",
                "type_preset": "rte"
              }
            }
          },
          "block_order": ["newsletter-heading", "newsletter-text"]
        },
        "newsletter-form": {
          "type": "email-signup",
          "settings": {
            "width": "fill"
          }
        }
      },
      "block_order": ["newsletter-group", "newsletter-form"]
    }
  ]
}
{% endschema %}
