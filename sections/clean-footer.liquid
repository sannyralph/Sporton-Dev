{% comment %}
  Sporton — Clean footer
  White editorial footer with newsletter signup, navigation columns,
  social links, payment icons, and country selector.
{% endcomment %}

<footer class="sporton-clean-footer">
  <div class="sporton-clean-footer__newsletter">
    <div class="sporton-clean-footer__container">
      {% if section.settings.newsletter_heading != blank %}
        <h2 class="sporton-clean-footer__newsletter-heading">
          {{ section.settings.newsletter_heading | escape }}
        </h2>
      {% endif %}

      {% if section.settings.newsletter_text != blank %}
        <p class="sporton-clean-footer__newsletter-text">
          {{ section.settings.newsletter_text | escape }}
        </p>
      {% endif %}

      {% form 'customer', class: 'sporton-clean-footer__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="SportonFooterEmail-{{ section.id }}">
          Email address
        </label>
        <div class="sporton-clean-footer__form-row">
          <input
            id="SportonFooterEmail-{{ section.id }}"
            class="sporton-clean-footer__email"
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            placeholder="Email address"
            required
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="SportonFooterEmailError-{{ section.id }}"
            {% endif %}
          >
          <button class="sporton-clean-footer__submit" type="submit">
            {{ section.settings.newsletter_button | default: 'Subscribe' | escape }}
          </button>
        </div>

        {% if form.posted_successfully? %}
          <p class="sporton-clean-footer__form-message" role="status">
            Thanks for subscribing.
          </p>
        {% elsif form.errors %}
          <p id="SportonFooterEmailError-{{ section.id }}" class="sporton-clean-footer__form-message" role="alert">
            {{ form.errors | default_errors }}
          </p>
        {% endif %}
      {% endform %}
    </div>
  </div>

  <div class="sporton-clean-footer__main">
    <div class="sporton-clean-footer__container sporton-clean-footer__grid">
      {% assign about_menu = section.settings.about_menu %}
      <nav class="sporton-clean-footer__menu sporton-clean-footer__menu--about" aria-label="{{ section.settings.about_heading | default: 'About Sporton' | escape }}">
        <button
          class="sporton-clean-footer__menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="SportonFooterMenuAbout-{{ section.id }}"
          data-footer-menu-toggle
        >
          <span>{{ section.settings.about_heading | default: 'About Sporton' | escape }}</span>
          <svg class="sporton-clean-footer__menu-chevron" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path d="m3 6 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div id="SportonFooterMenuAbout-{{ section.id }}" class="sporton-clean-footer__menu-panel">
          {% if about_menu != blank %}
            <ul>
              {% for link in about_menu.links %}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      </nav>

      {% assign support_menu = section.settings.support_menu %}
      {% if support_menu != blank %}
        <nav class="sporton-clean-footer__menu sporton-clean-footer__menu--support" aria-label="{{ section.settings.support_heading | escape }}">
          <button
            class="sporton-clean-footer__menu-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="SportonFooterMenuSupport-{{ section.id }}"
            data-footer-menu-toggle
          >
            <span>{{ section.settings.support_heading | escape }}</span>
            <svg class="sporton-clean-footer__menu-chevron" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <path d="m3 6 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div id="SportonFooterMenuSupport-{{ section.id }}" class="sporton-clean-footer__menu-panel">
            <ul>
              {% for link in support_menu.links %}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {% endfor %}
            </ul>
          </div>
        </nav>
      {% endif %}

      {% assign policy_menu = section.settings.policy_menu %}
      {% if policy_menu != blank %}
        <nav class="sporton-clean-footer__menu sporton-clean-footer__menu--policy" aria-label="{{ section.settings.policy_heading | escape }}">
          <button
            class="sporton-clean-footer__menu-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="SportonFooterMenuPolicy-{{ section.id }}"
            data-footer-menu-toggle
          >
            <span>{{ section.settings.policy_heading | escape }}</span>
            <svg class="sporton-clean-footer__menu-chevron" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <path d="m3 6 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div id="SportonFooterMenuPolicy-{{ section.id }}" class="sporton-clean-footer__menu-panel">
            <ul>
              {% for link in policy_menu.links %}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {% endfor %}
            </ul>
          </div>
        </nav>
      {% endif %}


      {% if section.settings.gift_card_link != blank or section.settings.gift_card_image != blank %}
        <div class="sporton-clean-footer__gift-card-column">
          {% if section.settings.gift_card_image != blank %}
            {{
              section.settings.gift_card_image
              | image_url: width: 600
              | image_tag:
                loading: 'lazy',
                widths: '300, 450, 600',
                sizes: '(min-width: 750px) 25vw, 100vw',
                class: 'sporton-clean-footer__gift-card-image',
                alt: section.settings.gift_card_heading
            }}
          {% endif %}
          {% if section.settings.gift_card_heading != blank %}
            <h3>{{ section.settings.gift_card_heading | escape }}</h3>
          {% endif %}
          {% if section.settings.gift_card_text != blank %}
            <p>{{ section.settings.gift_card_text | escape }}</p>
          {% endif %}
          {% if section.settings.gift_card_link != blank %}
            <a class="sporton-clean-footer__gift-card-button" href="{{ section.settings.gift_card_link }}">
              {{ section.settings.gift_card_button | default: 'Shop gift cards' | escape }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>

  <div class="sporton-clean-footer__lower">
    <div class="sporton-clean-footer__container sporton-clean-footer__lower-grid">
      {% if section.settings.show_payment_icons %}
        <div class="sporton-clean-footer__payments" aria-label="Payment methods">
          {% for type in shop.enabled_payment_types %}
            {{ type | payment_type_svg_tag: class: 'sporton-clean-footer__payment-icon' }}
          {% endfor %}
        </div>
      {% endif %}

      {% if section.settings.instagram_link != blank or section.settings.facebook_link != blank or section.settings.youtube_link != blank or section.settings.tiktok_link != blank or section.settings.pinterest_link != blank or section.settings.x_link != blank %}
        <div class="sporton-clean-footer__socials" aria-label="Social media">
          {% if section.settings.instagram_link != blank %}
            <a href="{{ section.settings.instagram_link }}" aria-label="Instagram" target="_blank" rel="noopener">
              <svg class="sporton-clean-footer__social-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/>
                <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8"/>
                <circle cx="17.4" cy="6.7" r="1.1" fill="currentColor"/>
              </svg>
              <span class="visually-hidden">Instagram</span>
            </a>
          {% endif %}
          {% if section.settings.facebook_link != blank %}
            <a href="{{ section.settings.facebook_link }}" aria-label="Facebook" target="_blank" rel="noopener">
              <svg class="sporton-clean-footer__social-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M14 21v-8h2.7l.4-3H14V8.1c0-.9.3-1.5 1.6-1.5h1.7V4a22 22 0 0 0-2.4-.1c-2.4 0-4 1.5-4 4.1V10H8.2v3H11v8h3Z" fill="currentColor"/>
              </svg>
              <span class="visually-hidden">Facebook</span>
            </a>
          {% endif %}
          {% if section.settings.youtube_link != blank %}
            <a href="{{ section.settings.youtube_link }}" aria-label="YouTube" target="_blank" rel="noopener">
              <svg class="sporton-clean-footer__social-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <rect x="2.5" y="5.5" width="19" height="13" rx="4" fill="none" stroke="currentColor" stroke-width="1.8"/>
                <path d="m10 9 5 3-5 3V9Z" fill="currentColor"/>
              </svg>
              <span class="visually-hidden">YouTube</span>
            </a>
          {% endif %}
          {% if section.settings.tiktok_link != blank %}
            <a href="{{ section.settings.tiktok_link }}" aria-label="TikTok" target="_blank" rel="noopener">
              <svg class="sporton-clean-footer__social-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M14.4 4h2.8c.3 1.7 1.3 2.8 2.8 3.3v2.8a8 8 0 0 1-2.8-1v6.3a4.8 4.8 0 1 1-4.8-4.8c.3 0 .6 0 .9.1v2.9a2.2 2.2 0 1 0 1.1 1.8V4Z" fill="currentColor"/>
              </svg>
              <span class="visually-hidden">TikTok</span>
            </a>
          {% endif %}
          {% if section.settings.pinterest_link != blank %}
            <a href="{{ section.settings.pinterest_link }}" aria-label="Pinterest" target="_blank" rel="noopener">
              <svg class="sporton-clean-footer__social-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M12 3.5a8.5 8.5 0 0 0-3.1 16.4c-.1-1.4 0-3 .4-4.4l1-4.1s-.3-.7-.3-1.7c0-1.6.9-2.8 2.1-2.8 1 0 1.5.7 1.5 1.6 0 1-.6 2.4-.9 3.7-.3 1.1.6 2 1.7 2 2 0 3.4-2.1 3.4-4.8 0-2.5-1.8-4.3-4.5-4.3-3.1 0-5 2.3-5 4.9 0 .9.3 1.8.8 2.4.1.1.1.2.1.4l-.3 1.2c-.1.4-.4.5-.7.3-1.3-.6-2.1-2.5-2.1-4 0-3.3 2.4-6.4 7.1-6.4 3.7 0 6.5 2.6 6.5 6 0 3.6-2.3 6.5-5.5 6.5-1.1 0-2.2-.6-2.6-1.3l-.7 2.8c-.3 1.3-1 2.9-1.5 3.8.9.3 1.9.5 2.9.5A8.5 8.5 0 1 0 12 3.5Z" fill="currentColor"/>
              </svg>
              <span class="visually-hidden">Pinterest</span>
            </a>
          {% endif %}
          {% if section.settings.x_link != blank %}
            <a href="{{ section.settings.x_link }}" aria-label="X" target="_blank" rel="noopener">
              <svg class="sporton-clean-footer__social-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M4 4h4.4l3.3 4.6L15.6 4H20l-6.2 7.1L20.3 20h-4.4l-3.7-5-4.3 5H3.5l6.5-7.5L4 4Zm3.1 1.8 8.9 12.4h1.4L8.5 5.8H7.1Z" fill="currentColor"/>
              </svg>
              <span class="visually-hidden">X</span>
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>

  <div class="sporton-clean-footer__legal">
    <div class="sporton-clean-footer__container sporton-clean-footer__legal-grid">
      <p>
        {{ section.settings.copyright_text | default: '© 2026 Sporton. All rights reserved.' | escape }}
      </p>

      <div class="sporton-clean-footer__legal-links">
        {% if section.settings.legal_menu != blank %}
          {% for link in section.settings.legal_menu.links %}
            <a href="{{ link.url }}">{{ link.title | escape }}</a>
          {% endfor %}
        {% endif %}

        {% if localization.available_countries.size > 1 %}
          {% form 'localization', id: 'SportonFooterCountryForm', class: 'sporton-clean-footer__country-form' %}
            <label class="visually-hidden" for="SportonFooterCountry-{{ section.id }}">Country</label>
            <select id="SportonFooterCountry-{{ section.id }}" name="country_code" onchange="this.form.submit()" aria-label="Country">
              {% for country in localization.available_countries %}
                <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
                  {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                </option>
              {% endfor %}
            </select>
          {% endform %}
        {% endif %}
      </div>
    </div>
  </div>
</footer>

<style>
  .sporton-clean-footer {
    font-family: 'Montserrat', var(--font-body--family), Arial, sans-serif;
  }

  .sporton-clean-footer .sporton-clean-footer__menu-toggle {
    all: unset;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 24px;
    margin: 0;
    padding: 0;
    color: #111111;
    font-family: 'Montserrat', var(--font-body--family), Arial, sans-serif;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-align: left;
    text-transform: uppercase;
    cursor: pointer;
  }

  .sporton-clean-footer .sporton-clean-footer__menu-chevron {
    display: none;
    width: 16px;
    height: 16px;
    flex: 0 0 16px;
  }

  .sporton-clean-footer .sporton-clean-footer__menu-panel {
    display: block;
  }

  .sporton-clean-footer .sporton-clean-footer__menu-panel ul {
    margin-top: 28px;
  }

  .sporton-clean-footer .sporton-clean-footer__menu-panel a,
  .sporton-clean-footer .sporton-clean-footer__gift-card-column p,
  .sporton-clean-footer .sporton-clean-footer__gift-card-button {
    font-family: 'Montserrat', var(--font-body--family), Arial, sans-serif;
  }

  @media screen and (min-width: 990px) {
    .sporton-clean-footer .sporton-clean-footer__grid {
      grid-template-columns: 170px 170px 210px minmax(0, 1fr);
      column-gap: 28px;
      row-gap: 0;
      align-items: start;
    }

    .sporton-clean-footer .sporton-clean-footer__menu--support,
    .sporton-clean-footer .sporton-clean-footer__menu--policy {
      margin-left: 0;
    }

    .sporton-clean-footer .sporton-clean-footer__gift-card-column {
      justify-self: end;
      width: min(100%, 340px);
      margin-left: 0;
    }
  }

  @media screen and (max-width: 749px) {
    .sporton-clean-footer .sporton-clean-footer__menu-toggle {
      min-height: 48px;
      padding: 0;
    }

    .sporton-clean-footer .sporton-clean-footer__menu-chevron {
      display: block;
    }

    .sporton-clean-footer .sporton-clean-footer__menu-panel {
      display: none;
      padding-bottom: 20px;
    }

    .sporton-clean-footer .sporton-clean-footer__menu.is-open .sporton-clean-footer__menu-panel {
      display: block;
    }

    .sporton-clean-footer .sporton-clean-footer__menu.is-open .sporton-clean-footer__menu-chevron {
      transform: rotate(180deg);
    }

    .sporton-clean-footer .sporton-clean-footer__menu-panel ul {
      margin-top: 0;
    }

    .sporton-clean-footer .sporton-clean-footer__gift-card-column {
      margin-top: 28px;
      padding-top: 36px;
    }
  }
</style>

<script>
  (() => {
    const footer = document.querySelector('.sporton-clean-footer');
    if (!footer || footer.dataset.menuInitialized === 'true') return;

    footer.dataset.menuInitialized = 'true';
    const mobileQuery = window.matchMedia('(max-width: 749px)');
    const menus = footer.querySelectorAll('[data-footer-menu-toggle]');

    const syncMenuState = () => {
      menus.forEach((toggle) => {
        const menu = toggle.closest('.sporton-clean-footer__menu');
        const expanded = mobileQuery.matches ? menu.classList.contains('is-open') : true;
        toggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
      });
    };

    menus.forEach((toggle) => {
      toggle.addEventListener('click', () => {
        if (!mobileQuery.matches) return;
        const menu = toggle.closest('.sporton-clean-footer__menu');
        menu.classList.toggle('is-open');
        syncMenuState();
      });
    });

    mobileQuery.addEventListener('change', syncMenuState);
    syncMenuState();
  })();
</script>

{% stylesheet %}
  .sporton-clean-footer {
    --sporton-footer-ink: #111111;
    --sporton-footer-muted: #696969;
    --sporton-footer-line: #e5e5e5;
    background: #ffffff;
    color: var(--sporton-footer-ink);
    border-top: 1px solid var(--sporton-footer-line);
  }

  .sporton-clean-footer__container {
    width: min(100% - 48px, 1440px);
    margin-inline: auto;
  }

  .sporton-clean-footer__newsletter {
    padding: clamp(64px, 8vw, 120px) 0 clamp(64px, 7vw, 104px);
    background: #f7f7f7;
    text-align: center;
  }

  .sporton-clean-footer__newsletter-heading {
    margin: 0;
    color: var(--sporton-footer-ink);
    font-size: clamp(2rem, 4.4vw, 4.1rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: 0.015em;
    text-transform: uppercase;
  }

  .sporton-clean-footer__newsletter-text {
    max-width: 760px;
    margin: 24px auto 0;
    color: var(--sporton-footer-ink);
    font-size: 16px;
    line-height: 1.55;
  }

  .sporton-clean-footer__form {
    max-width: 680px;
    margin: 42px auto 0;
  }

  .sporton-clean-footer__form-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 20px;
  }

  .sporton-clean-footer__email {
    min-height: 66px;
    padding: 0 24px;
    border: 1px solid #d6d6d6;
    border-radius: 4px;
    background: #ffffff;
    color: var(--sporton-footer-ink);
    font-size: 16px;
  }

  .sporton-clean-footer__email::placeholder {
    color: #777777;
    opacity: 1;
  }

  .sporton-clean-footer__submit {
    min-width: 206px;
    min-height: 66px;
    padding: 0 28px;
    border: 1px solid var(--sporton-footer-ink);
    border-radius: 4px;
    background: var(--sporton-footer-ink);
    color: #ffffff;
    cursor: pointer;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .sporton-clean-footer__submit:hover {
    background: #ffffff;
    color: var(--sporton-footer-ink);
  }

  .sporton-clean-footer__form-message {
    margin: 16px 0 0;
    color: var(--sporton-footer-ink);
    font-size: 14px;
  }

  .sporton-clean-footer__gift-card-column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .sporton-clean-footer__gift-card-image {
    display: block;
    width: min(100%, 220px);
    aspect-ratio: 1.6 / 1;
    margin: 0 0 22px;
    object-fit: cover;
    background: #f2f2f2;
  }

  .sporton-clean-footer__gift-card-column h3 {
    margin: 0 0 18px;
    color: var(--sporton-footer-ink);
    font-size: 13px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .sporton-clean-footer__gift-card-column p {
    max-width: 280px;
    margin: 0 0 22px;
    color: var(--sporton-footer-muted);
    font-size: 15px;
    line-height: 1.55;
  }

  .sporton-clean-footer__gift-card-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 10px 18px;
    border: 1px solid var(--sporton-footer-ink);
    border-radius: 999px;
    background: var(--sporton-footer-ink);
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .sporton-clean-footer__gift-card-button:hover {
    background: #ffffff;
    color: var(--sporton-footer-ink);
  }

  .sporton-clean-footer__main {
    padding: 76px 0 64px;
    background: #ffffff;
  }

  .sporton-clean-footer__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: start;
    gap: 48px;
  }

  .sporton-clean-footer__brand {
    grid-column: 1;
  }

  .sporton-clean-footer__menu--support {
    grid-column: 2;
  }

  .sporton-clean-footer__menu--policy {
    grid-column: 3;
  }

  .sporton-clean-footer__gift-card-column {
    grid-column: 4;
  }

  .sporton-clean-footer__brand-heading {
    margin: 30px 0 20px;
    color: var(--sporton-footer-ink);
    font-size: 13px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .sporton-clean-footer__logo {
    display: block;
    width: min(180px, 100%);
    height: auto;
  }

  .sporton-clean-footer__wordmark {
    display: inline-block;
    color: var(--sporton-footer-ink);
    font-size: 28px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .sporton-clean-footer__brand-text {
    max-width: 280px;
    margin: 24px 0 0;
    color: var(--sporton-footer-muted);
    font-size: 14px;
    line-height: 1.6;
  }

  .sporton-clean-footer__menu h3 {
    margin: 0 0 28px;
    color: var(--sporton-footer-ink);
    font-size: 13px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .sporton-clean-footer__menu ul {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sporton-clean-footer__menu a,
  .sporton-clean-footer__legal a,
  .sporton-clean-footer__socials a {
    color: var(--sporton-footer-muted);
    font-size: 15px;
    line-height: 1.45;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .sporton-clean-footer__menu a:hover,
  .sporton-clean-footer__legal a:hover,
  .sporton-clean-footer__socials a:hover {
    color: var(--sporton-footer-ink);
  }

  .sporton-clean-footer__lower {
    padding: 28px 0;
    background: #ffffff;
  }

  .sporton-clean-footer__lower-grid {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .sporton-clean-footer__payments {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .sporton-clean-footer__payment-icon {
    width: auto;
    max-width: 42px;
    height: 24px;
  }

  .sporton-clean-footer__socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 20px;
  }

  .sporton-clean-footer__socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    color: var(--sporton-footer-ink);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .sporton-clean-footer__socials a:hover {
    opacity: 0.55;
  }

  .sporton-clean-footer__social-icon {
    display: block;
    width: 21px;
    height: 21px;
  }

  .sporton-clean-footer__legal {
    padding: 22px 0;
    background: #f4f4f4;
  }

  .sporton-clean-footer__legal-grid {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .sporton-clean-footer__legal p {
    margin: 0;
    color: var(--sporton-footer-muted);
    font-size: 13px;
  }

  .sporton-clean-footer__legal-links {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 18px;
  }

  .sporton-clean-footer__country-form select {
    min-height: 32px;
    padding: 4px 28px 4px 8px;
    border: 0;
    background: transparent;
    color: var(--sporton-footer-muted);
    font-size: 13px;
    cursor: pointer;
  }

  @media screen and (max-width: 989px) {
    .sporton-clean-footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .sporton-clean-footer__brand {
      grid-column: 1 / -1;
    }

    .sporton-clean-footer__menu--support,
    .sporton-clean-footer__menu--policy,
    .sporton-clean-footer__gift-card-column {
      grid-column: auto;
    }
  }

  @media screen and (max-width: 749px) {
    .sporton-clean-footer__container {
      width: min(100% - 32px, 600px);
    }

    .sporton-clean-footer__newsletter {
      padding: 56px 0 60px;
    }

    .sporton-clean-footer__newsletter-heading {
      font-size: clamp(2rem, 10vw, 3.25rem);
    }

    .sporton-clean-footer__newsletter-text {
      margin-top: 18px;
      font-size: 14px;
    }

    .sporton-clean-footer__form {
      margin-top: 30px;
    }

    .sporton-clean-footer__form-row {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .sporton-clean-footer__email,
    .sporton-clean-footer__submit {
      min-height: 56px;
    }

    .sporton-clean-footer__submit {
      width: 100%;
    }

    .sporton-clean-footer__main {
      padding: 48px 0 36px;
    }

    .sporton-clean-footer__gift-card-column {
      padding: 22px 0;
      border-bottom: 1px solid var(--sporton-footer-line);
    }

    .sporton-clean-footer__gift-card-image {
      width: min(100%, 260px);
    }

    .sporton-clean-footer__gift-card-button {
      width: 100%;
    }

    .sporton-clean-footer__grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .sporton-clean-footer__brand,
    .sporton-clean-footer__menu,
    .sporton-clean-footer__gift-card-column {
      grid-column: auto;
      padding: 22px 0;
      border-bottom: 1px solid var(--sporton-footer-line);
    }

    .sporton-clean-footer__menu h3 {
      margin-bottom: 18px;
    }

    .sporton-clean-footer__lower-grid,
    .sporton-clean-footer__legal-grid {
      align-items: flex-start;
      flex-direction: column;
    }

    .sporton-clean-footer__socials {
      justify-content: flex-start;
    }

    .sporton-clean-footer__legal-links {
      justify-content: flex-start;
    }
  }

  /* AYBL-inspired desktop menu grouping and typography */
  .sporton-clean-footer {
    font-family: 'Montserrat', var(--font-body--family), Arial, sans-serif;
  }

  .sporton-clean-footer__newsletter-heading,
  .sporton-clean-footer__menu-toggle,
  .sporton-clean-footer__gift-card-column h3,
  .sporton-clean-footer__submit,
  .sporton-clean-footer__gift-card-button {
    font-family: 'Montserrat', var(--font-body--family), Arial, sans-serif;
  }

  @media screen and (min-width: 990px) {
    .sporton-clean-footer__grid {
      grid-template-columns: minmax(130px, 0.7fr) minmax(130px, 0.7fr) minmax(170px, 0.8fr) minmax(300px, 1.2fr);
      column-gap: 24px;
      row-gap: 0;
    }

    .sporton-clean-footer__menu--support,
    .sporton-clean-footer__menu--policy {
      margin-left: -18px;
    }

    .sporton-clean-footer__gift-card-column {
      margin-left: clamp(32px, 4vw, 82px);
    }
  }

  /* Menu headings are buttons for keyboard-accessible mobile dropdowns. */
  .sporton-clean-footer__menu-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--sporton-footer-ink);
    font-size: 13px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-align: left;
    text-transform: uppercase;
    cursor: pointer;
  }

  .sporton-clean-footer__menu-chevron {
    display: none;
    width: 16px;
    height: 16px;
    transition: transform 0.2s ease;
  }

  .sporton-clean-footer__menu-panel {
    display: block;
  }

  .sporton-clean-footer__menu-panel ul {
    margin-top: 28px;
  }

  @media screen and (max-width: 749px) {
    .sporton-clean-footer__menu-toggle {
      min-height: 48px;
      padding: 0;
    }

    .sporton-clean-footer__menu-chevron {
      display: block;
    }

    .sporton-clean-footer__menu-panel {
      display: none;
      padding-bottom: 20px;
    }

    .sporton-clean-footer__menu.is-open .sporton-clean-footer__menu-panel {
      display: block;
    }

    .sporton-clean-footer__menu.is-open .sporton-clean-footer__menu-chevron {
      transform: rotate(180deg);
    }

    .sporton-clean-footer__menu-panel ul {
      margin-top: 0;
    }

    .sporton-clean-footer__gift-card-column {
      margin-top: 28px;
      padding-top: 36px;
    }
  }
{% endstylesheet %}

