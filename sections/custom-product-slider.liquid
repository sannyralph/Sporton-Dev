{% comment %} Custom Product Slider Section {% endcomment %}

{%- liquid
  assign collection = section.settings.collection
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign view_all_text = section.settings.view_all_text | default: 'View All'
  assign products_to_show = section.settings.products_to_show | default: 8
-%}

<section class="custom-slider-section">
  <div class="custom-slider-section__header">
    <div class="custom-slider-section__titles">
      {%- if heading != blank -%}
        <h2 class="custom-slider-section__heading">{{ heading }}</h2>
      {%- endif -%}
      {%- if subheading != blank -%}
        <p class="custom-slider-section__subheading">{{ subheading }}</p>
      {%- endif -%}
    </div>
    {%- if collection != blank and view_all_text != blank -%}
      <a href="{{ collection.url }}" class="custom-slider-section__view-all">
        {{ view_all_text }}
      </a>
    {%- endif -%}
  </div>

  <div class="custom-slider-track-wrapper">
    <div class="custom-slider-track">
      {%- if collection != blank -%}
        {%- for product in collection.products limit: 4 -%}
          {%- liquid
            assign is_new = false
            for tag in product.tags
              if tag == 'new'
                assign is_new = true
              endif
            endfor

            assign color_option_index = nil
            assign size_option_index = nil
            for option in product.options_with_values
              assign option_name_downcase = option.name | downcase
              if option_name_downcase == 'color' or option_name_downcase == 'colour'
                assign color_option_index = forloop.index0
              endif
              if option_name_downcase == 'size'
                assign size_option_index = forloop.index0
              endif
            endfor
          -%}

          <a href="{{ product.url }}" class="custom-product-card">
            <div class="custom-product-card__image-wrapper">
              {%- if is_new -%}
                <span class="custom-product-card__badge">New</span>
              {%- endif -%}
              {%- if product.featured_image -%}
                {{
                  product.featured_image
                  | image_url: width: 600
                  | image_tag:
                    loading: 'lazy',
                    alt: product.title,
                    class: 'custom-product-card__image',
                    widths: '300, 400, 600'
                }}
              {%- endif -%}

              {% comment %} Quick select overlay {% endcomment %}
              <div class="custom-product-card__quick-select">
                <p class="custom-product-card__quick-label">Quick Select</p>

                {%- if color_option_index != nil -%}
                  <div class="custom-product-card__colors">
                    {%- assign color_option = product.options_with_values[color_option_index] -%}
                    {%- for value in color_option.values -%}
                      {%- assign color_value_downcase = value | downcase | replace: ' ', '-' -%}
                      <span
                        class="custom-product-card__color-swatch"
                        title="{{ value }}"
                        style="background-color: {{ color_value_downcase }};"
                      ></span>
                    {%- endfor -%}
                  </div>
                {%- endif -%}

                {%- if size_option_index != nil -%}
  <div class="custom-product-card__sizes">
    {%- assign size_option = product.options_with_values[size_option_index] -%}
    {%- for size_value in size_option.values -%}
      {%- liquid
        assign variant_for_size = nil
        for v in product.variants
          if size_value == v.options[size_option_index]
            assign variant_for_size = v
          endif
        endfor
      -%}

      {%- if variant_for_size != nil -%}
        <form method="post" action="/cart/add" class="size-add-form" style="margin:0;">
          <input type="hidden" name="id" value="{{ variant_for_size.id }}">
          <button type="submit" class="custom-product-card__size-pill" aria-label="Add size {{ size_value }}">
            {{ size_value }}
          </button>
        </form>
      {%- else -%}
        <span class="custom-product-card__size-pill" aria-hidden="true">{{ size_value }}</span>
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- endif -%}
              </div>
            </div>

            <div class="custom-product-card__info">
              <p class="custom-product-card__title">{{ product.title }}</p>
              <p class="custom-product-card__price">{{ product.price | money }}</p>
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        <p class="custom-slider-section__empty">Select a collection in the theme editor.</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .custom-slider-section {
    padding: 48px 24px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .custom-slider-section__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 24px;
  }

  .custom-slider-section__heading {
    font-size: 22px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 4px;
  }

  .custom-slider-section__subheading {
    font-size: 14px;
    color: #666;
    margin: 0;
  }

  .custom-slider-section__view-all {
    font-size: 14px;
    font-weight: 500;
    text-decoration: underline;
    color: inherit;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .custom-slider-track-wrapper {
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    cursor: grab;
    -webkit-overflow-scrolling: touch;
  }

  .custom-slider-track-wrapper::-webkit-scrollbar {
    display: none;
  }

  .custom-slider-track-wrapper.is-dragging {
    cursor: grabbing;
    user-select: none;
  }

  .custom-slider-track {
    display: flex;
    gap: 16px;
    width: max-content;
  }

  .custom-product-card {
    display: block;
  text-decoration: none;
  color: inherit;
  width: 320px;         /* desktop size (bigger) */
  flex-shrink: 0;
  }

  .custom-product-card__image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #f5f5f5;
    border-radius: 4px;
    margin-bottom: 12px;
  }

  .custom-product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .custom-product-card:hover .custom-product-card__image {
    transform: scale(1.04);
  }

  .custom-product-card__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    background: #fff;
    color: #111;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 20px;
  }

  /* Quick select overlay */
 .custom-product-card__quick-select {
  position: absolute;
  left: 12px;
  right: 12px;
  bottom: 12px;
  background: rgba(255, 255, 255, 0.96);
  padding: 10px 12px;
  border-radius: 6px;

  /* critical: keep overlay compact */
  transform: translateY(18px);
  opacity: 0;
  transition: transform 0.25s ease, opacity 0.25s ease;

  z-index: 3;

  display: flex;
  flex-direction: column;
  gap: 8px;
}

.custom-product-card:hover .custom-product-card__quick-select {
  transform: translateY(0);
  opacity: 1;
}

  .custom-product-card:hover .custom-product-card__quick-select {
    transform: translateY(0);
  }

  .custom-product-card__quick-label {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #111;
    margin: 0 0 8px;
  }

.custom-product-card__size-pill {
  display: inline-flex;
  justify-content: center;
  width: 44px;      /* adjust if needed */
}
.custom-product-card__size-pill {
  width: fit-content;
}

  .custom-product-card__color-swatch {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 1.5px solid rgba(0,0,0,0.15);
    display: inline-block;
    cursor: pointer;
    transition: transform 0.15s ease;
  }

  .custom-product-card__color-swatch:hover {
    transform: scale(1.2);
    border-color: #111;
  }

.custom-product-card__sizes {
  display: flex;
  flex-wrap: wrap;
  justify-content: center; /* centers the row */
  align-items: center;
  gap: 6px;

  /* important: prevents the container from looking “one-sided” */
  width: 100%;
}

.custom-product-card__size-pill {
  border-radius: 4px;
    width: auto;
  min-width: 36px; /* optional: keeps pills consistent */
}

.size-add-form button.custom-product-card__size-pill {
  cursor: pointer;
  background: #fff;
}

  .custom-product-card__size-pill {
    font-size: 11px;
    font-weight: 500;
    padding: 3px 8px;
    border: 1px solid #ccc;
    border-radius: 3px;
    cursor: pointer;
    background: #fff;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .custom-product-card__size-pill:hover {
    background: #111;
    color: #fff;
    border-color: #111;
  }

  .custom-product-card__info {
    padding: 0 4px;
  }

  .custom-product-card__title {
    font-size: 12px;
    font-weight: 500;
    margin: 0 0 4px;
    line-height: 1.3;
  }

  .custom-product-card__variant {
    font-size: 13px;
    color: #888;
    margin: 0 0 4px;
  }

  .custom-product-card__price {
    font-size: 12px;
    font-weight: 500;
    margin: 0;
    color: #757575 !important;
  }

 @media (max-width: 749px) {
  .custom-product-card {
    width: 180px;       /* mobile size (smaller) */
  }


    .custom-slider-section {
      padding: 32px 16px;
    }
  }
{% endstylesheet %}

{% javascript %}
  const wrapper = document.querySelector('.custom-slider-track-wrapper');
  if (wrapper) {
    let isDown = false;
    let startX;
    let scrollLeft;

    wrapper.addEventListener('mousedown', (e) => {
      isDown = true;
      wrapper.classList.add('is-dragging');
      startX = e.pageX - wrapper.offsetLeft;
      scrollLeft = wrapper.scrollLeft;
    });

    wrapper.addEventListener('mouseleave', () => {
      isDown = false;
      wrapper.classList.remove('is-dragging');
    });

    wrapper.addEventListener('mouseup', () => {
      isDown = false;
      wrapper.classList.remove('is-dragging');
    });

    wrapper.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - wrapper.offsetLeft;
      const walk = (x - startX) * 1.5;
      wrapper.scrollLeft = scrollLeft - walk;
    });
  }
{% endjavascript %}

{% schema %}
{
  "name": "Product Slider",
  "tag": "div",
  "class": "custom-product-slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover the latest styles"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All label",
      "default": "View All"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Number of products",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Product Slider"
    }
  ]
}
{% endschema %}