              "blocks": {}
            },
            "text_qFzXda": {
              "type": "text",
              "settings": {
                "text": "<ul><li><strong>Balance: </strong> Improve stability, coordination, and body control.</li></ul><p></p><ul><li><strong>Mobility: </strong> Increase range of motion while continuing to build strength.</li></ul><p></p><ul><li><strong>Recovery: </strong>Support active recovery and help your body move more efficiently.</li></ul><p></p><ul><li><strong>Injury prevention: </strong> Improve alignment, control, and movement quality to help reduce unnecessary strain.</li></ul><p></p><ul><li><strong>Core strength: </strong> Build deep strength that supports lifting, running, sport, and everyday movement.</li></ul><p></p><ul><li><strong>Better posture: </strong> Strengthen the muscles that help you stand, sit, and move with better alignment.</li></ul><p></p>",
                "width": "100%",
                "max_width": "normal",
