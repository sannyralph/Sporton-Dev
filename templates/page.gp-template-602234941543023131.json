            "text_97z6BB": {
              "type": "text",
              "name": "t:names.heading",
              "settings": {
                "text": "<p>WHY PILATES?</p>",
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "h3",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
