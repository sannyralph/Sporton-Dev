        "gg6SwMkPru9_text": "<span style=\"background-color:rgb(255,255,255);color:rgb(0,0,0);font-size:medium;\">GET EXCLUSIVE  PERKS FROM US.</span>",
        "gg1ZUh6D0rd_text": "<p>Sign up to be the first to hear about exclusive deals, special offers and upcoming collections</p>",
